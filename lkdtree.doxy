# -----------------------------------------------------------------------------
# Project Information
# -----------------------------------------------------------------------------
PROJECT_NAME           = "lkdtree"
PROJECT_BRIEF          = "A fast incremental KdTree for real-time applications"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO

# -----------------------------------------------------------------------------
# Input
# -----------------------------------------------------------------------------
INPUT                  = include src
FILE_PATTERNS          = *.hpp *.h *.cpp *.cc *.md
RECURSIVE              = YES
EXCLUDE                = test

# -----------------------------------------------------------------------------
# Main Page
# -----------------------------------------------------------------------------
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES

# -----------------------------------------------------------------------------
# Extract Information
# -----------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO

# -----------------------------------------------------------------------------
# HTML Output
# -----------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO

# -----------------------------------------------------------------------------
# Source Browser
# -----------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# -----------------------------------------------------------------------------
# Dot / Graphviz Support
# -----------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 2
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES
UML_LOOK               = YES
TEMPLATE_RELATIONS     = YES
INTERACTIVE_SVG        = YES

# -----------------------------------------------------------------------------
# Warnings
# -----------------------------------------------------------------------------
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_FORMAT            = "$file:$line: $text"

# -----------------------------------------------------------------------------
# Sorting / Style
# -----------------------------------------------------------------------------
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_GROUP_NAMES       = YES
FULL_PATH_NAMES        = NO
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO
TAB_SIZE               = 2

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
QUIET                  = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
